{
  "type": "form",
  "display": "form",
  "components": [
    {
      "label": "Checkbox",
      "tableView": false,
      "key": "checkbox",
      "type": "checkbox",
      "input": true
    },
    {
      "label": "Text Field",
      "applyMaskOn": "change",
      "tableView": true,
      "key": "textField",
      "conditional": {
        "show": true,
        "conjunction": "all",
        "conditions": [
          {
            "component": "checkbox",
            "operator": "isEqual",
            "value": "false"
          }
        ]
      },
      "type": "textfield",
      "input": true
    },
    {
      "type": "button",
      "label": "Submit",
      "key": "submit",
      "disableOnInvalid": true,
      "input": true,
      "tableView": false
    }
  ]
}
