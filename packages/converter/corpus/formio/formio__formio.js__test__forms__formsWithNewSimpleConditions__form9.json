{
  "type": "form",
  "title": "conditionally hidden component",
  "display": "form",
  "path": "conditionallyhiddencomponent",
  "components": [
    {
      "label": "Text Field",
      "applyMaskOn": "change",
      "tableView": true,
      "validateWhenHidden": false,
      "key": "textField",
      "type": "textfield",
      "input": true
    },
    {
      "label": "Text Field 1",
      "applyMaskOn": "change",
      "tableView": true,
      "validateWhenHidden": false,
      "key": "textField1",
      "conditional": {
        "show": false,
        "conjunction": "all",
        "conditions": [
          {
            "component": "textField",
            "operator": "includes",
            "value": "hide"
          }
        ]
      },
      "type": "textfield",
      "input": true
    },
    {
      "type": "button",
      "label": "Submit",
      "key": "submit",
      "disableOnInvalid": true,
      "input": true,
      "tableView": false
    }
  ]
}
