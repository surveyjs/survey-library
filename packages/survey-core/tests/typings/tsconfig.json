{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "lib": [
      "DOM",
      "ES2019"
    ],
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "moduleResolution": "node",
    "baseUrl": "../..",
    "types": [],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts"
  ]
}
