# /etc/systemd/system/perf-nightly.timer: 03:00 Europe/Berlin. Persistent=false: a night missed by a reboot is
# skipped, and the next run says so.
[Unit]
Description=survey-library nightly performance run at 03:00 Europe/Berlin

[Timer]
OnCalendar=*-*-* 03:00:00 Europe/Berlin
Persistent=false
Unit=perf-nightly.service

[Install]
WantedBy=timers.target
